{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "pa:aura_gozalev_element",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/iksir_aura"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 1
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.15
      },
      "minecraft:emitter_shape_sphere": {
        "offset": [
          0,
          0,
          0
        ],
        "radius": 0.03,
        "surface_only": false,
        "direction": "outwards"
      },
      "minecraft:particle_initial_speed": "0.05 + variable.particle_random_1 * 0.11",
      "minecraft:particle_initial_spin": {
        "rotation": "(variable.particle_random_2 - 0.5) * 20",
        "rotation_rate": "(variable.particle_random_3 - 0.5) * 40"
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.34 + variable.particle_random_4 * 0.10"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "variable.hiz.x * 68.0",
          "variable.hiz.y * 68.0 + 1.05",
          "variable.hiz.z * 68.0"
        ],
        "linear_drag_coefficient": 3.4,
        "rotation_drag_coefficient": 1.2
      },
      "minecraft:particle_motion_collision": {
        "enabled": true,
        "collision_radius": 0.02,
        "expire_on_contact": true
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "(0.185 + variable.particle_random_1 * 0.055) * (0.55 + 0.45 * math.sin(variable.particle_age / variable.particle_lifetime * 180)) * (1 + 0.14 * math.sin(variable.particle_age * 1150 + variable.particle_random_2 * 360)) * (0.85 + variable.emitter_random_1 * 0.3)",
          "(0.255 + variable.particle_random_1 * 0.075) * (0.55 + 0.45 * math.sin(variable.particle_age / variable.particle_lifetime * 180)) * (1 + 0.14 * math.sin(variable.particle_age * 1150 + variable.particle_random_2 * 360)) * (0.85 + variable.emitter_random_1 * 0.3)"
        ],
        "face_camera_mode": "lookat_y",
        "uv": {
          "texturewidth": 256,
          "textureheight": 32,
          "flipbook": {
            "base_UV": [
              0,
              0
            ],
            "size_UV": [
              32,
              32
            ],
            "step_UV": [
              32,
              0
            ],
            "max_frame": 8,
            "frames_per_second": 32,
            "loop": true,
            "stretch_to_lifetime": false
          }
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "gradient": {
            "0.0": [
              0.5451,
              0.9294,
              1.0,
              1.0
            ],
            "0.18": [
              0.2196,
              0.8824,
              1.0,
              1.0
            ],
            "0.55": [
              1.0,
              0.698,
              0.0,
              0.92
            ],
            "0.82": [
              0.8471,
              0.5922,
              0.0,
              0.5
            ],
            "1.0": [
              0.8471,
              0.5922,
              0.0,
              0.0
            ]
          },
          "interpolant": "variable.particle_age / variable.particle_lifetime"
        }
      }
    }
  }
}
