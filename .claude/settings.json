{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/olay.py\" dagit",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task|Read|Bash|mcp__claude-code-remote__create_session",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/olay.py\" dagit",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/olay.py\" dagit",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/olay.py\" dagit",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "allow": [
      "Bash(python3 .claude/dogrula.py:*)",
      "Bash(python3 .claude/saglik.py:*)",
      "Bash(python3 .claude/mandal.py olc)",
      "Bash(python3 .claude/mandal.py kontrol)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(python3 .claude/butunluk.py:*)",
      "Bash(python3 .claude/eniyile.py:*)",
      "Bash(python3 .claude/olay.py:*)"
    ]
  }
}
